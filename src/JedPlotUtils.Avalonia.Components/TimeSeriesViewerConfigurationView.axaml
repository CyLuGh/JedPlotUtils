<UserControl
  d:DesignHeight="400"
  d:DesignWidth="650"
  mc:Ignorable="d"
  x:Class="JedPlotUtils.Avalonia.Components.TimeSeriesViewerConfigurationView"
  x:DataType="viewModels:TimeSeriesViewerConfigurationViewModel"
  xmlns="https://github.com/avaloniaui"
  xmlns:converters="clr-namespace:JedPlotUtils.Avalonia.Components.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:palette="clr-namespace:JedPlotUtils.Palette;assembly=JedPlotUtils"
  xmlns:viewModels="clr-namespace:JedPlotUtils.ViewModels;assembly=JedPlotUtils"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <UserControl.Resources>
    <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
  </UserControl.Resources>
  <DockPanel VerticalSpacing="16">
    <UniformGrid DockPanel.Dock="Bottom" Rows="1">
      <CheckBox
        Content="Persist settings"
        IsChecked="{Binding PersistSettings}"
        Margin="10,0,0,5"
      />
      <StackPanel
        HorizontalAlignment="Right"
        Margin="0,0,5,5"
        Orientation="Horizontal"
        Spacing="5"
        VerticalAlignment="Bottom"
      >
        <Button
          Command="{Binding CancelCommand}"
          Content="Cancel"
          IsCancel="True"
          Theme="{DynamicResource GhostButtonTheme}"
        />
        <Button
          Classes="Primary"
          Command="{Binding SaveCommand}"
          CommandParameter="{Binding PersistSettings}"
          x:Name="ApplyButton"
        >
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Apply settings" />
          </StackPanel>
        </Button>
      </StackPanel>
    </UniformGrid>

    <StackPanel Spacing="4">
      <TextBlock
        FontSize="18"
        FontWeight="Bold"
        Margin="20,0"
        Text="Settings"
        VerticalAlignment="Center"
      />

      <Separator />

      <TabControl Margin="5">
        <TabItem Header="Layout">
          <UniformGrid ColumnSpacing="10" Columns="2" Margin="5" RowSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Selection mode" />
              <ComboBox
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableSeriesSelectionMode}"
                SelectedItem="{Binding SeriesSelectionMode}"
                Width="300"
              />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Display mode" />
              <ComboBox
                HorizontalAlignment="Left"
                ItemsSource="{Binding AvailableDisplayMode}"
                SelectedItem="{Binding DisplayMode}"
                Width="300"
              >
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Switch chart and grid positions" VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding SwitchChartAndGrid}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Show status bar" VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding ShowStatusBar}" />
            </StackPanel>
          </UniformGrid>
        </TabItem>
        <TabItem Header="Formatting">
          <UniformGrid ColumnSpacing="10" Columns="2" Margin="5" RowSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Date format" />
              <TextBox HorizontalAlignment="Left" Text="{Binding DateFormat}" Width="300" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Decimals" />
              <NumericUpDown
                FormatString="N0"
                HorizontalAlignment="Left"
                Maximum="10"
                Minimum="0"
                ParsingNumberStyle="Integer"
                Value="{Binding Decimals}"
                Width="300"
              />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Thousands separators" VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding HasThousandsSeparators}" />
            </StackPanel>
          </UniformGrid>
        </TabItem>
        <TabItem Header="Palette">
          <UniformGrid ColumnSpacing="10" Columns="2" Margin="5" RowSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Palette" />
              <ComboBox
                HorizontalAlignment="Left"
                ItemsSource="{x:Static palette:Palettes.Available}"
                SelectedItem="{Binding Palette}"
                Width="300"
              >
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="palette:IPalette">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </UniformGrid>
        </TabItem>
      </TabControl>
    </StackPanel>
  </DockPanel>
</UserControl>
