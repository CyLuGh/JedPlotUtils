<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="JedPlotUtils.LiveCharts.Avalonia.Components.DisaggregationResultsInfoView"
    x:DataType="models:TemporalDisaggregationResults"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:JDPlus.WS.Models;assembly=JDPlus.WS.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="#BBFFFFFF"
        CornerRadius="5"
        Margin="10"
        Padding="5">
        <TabControl>
            <TabItem Header="Statistics">
                <UniformGrid
                    ColumnSpacing="6"
                    Columns="2"
                    Margin="5"
                    RowSpacing="4"
                    VerticalAlignment="Top">
                    <TextBlock Text="N Obs:" />
                    <TextBlock Text="{Binding Statistics.NObs}" />

                    <TextBlock Text="N Diffuse:" />
                    <TextBlock Text="{Binding Statistics.NDiffuse}" />

                    <TextBlock Text="N Params:" />
                    <TextBlock Text="{Binding Statistics.NParams}" />
                </UniformGrid>
            </TabItem>
            <TabItem Header="Likelihood">
                <UniformGrid
                    ColumnSpacing="6"
                    Columns="2"
                    Margin="5"
                    RowSpacing="4"
                    VerticalAlignment="Top">
                    <TextBlock Text="N Obs:" />
                    <TextBlock Text="{Binding Likelihood.NObs}" />

                    <TextBlock Text="LL:" />
                    <TextBlock Text="{Binding Likelihood.Ll}" />

                    <TextBlock Text="ssqerr:" />
                    <TextBlock Text="{Binding Likelihood.SsqErr}" />
                </UniformGrid>
            </TabItem>
        </TabControl>

    </Border>
</UserControl>