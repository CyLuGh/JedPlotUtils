<UserControl
  x:Class="JedPlotUtils.LiveCharts.Avalonia.Components.TimeSeriesViewerConnectionView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewModels="clr-namespace:JedPlotUtils.ViewModels;assembly=JedPlotUtils"
  d:DesignHeight="450"
  d:DesignWidth="800"
  x:DataType="viewModels:TimeSeriesViewerConfigurationViewModel"
  mc:Ignorable="d">
  <StackPanel Spacing="16">
    <TextBlock
      Margin="20,0"
      VerticalAlignment="Center"
      FontSize="18"
      FontWeight="Bold"
      Text="JD+ Connection" />

    <Separator />

    <UniformGrid
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      Columns="1"
      RowSpacing="6">
      <DockPanel HorizontalSpacing="4">
        <TextBlock VerticalAlignment="Center" Text="JD+ Service:" />
        <TextBox MinWidth="300" Text="{Binding Path=WebServiceAddress}" />
      </DockPanel>
    </UniformGrid>

    <UniformGrid Rows="1">
      <CheckBox
        Margin="10,0,0,5"
        Content="Persist settings"
        IsChecked="{Binding PersistSettings}" />
      <StackPanel
        Margin="0,0,5,5"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Orientation="Horizontal"
        Spacing="5">
        <Button
          Command="{Binding CancelCommand}"
          Content="Cancel"
          IsCancel="True" />
        <Button
          Height="30"
          Command="{Binding SaveCommand}"
          CommandParameter="{Binding PersistSettings}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <!-- <Viewbox> -->
            <!--   <Canvas Width="24" Height="24"> -->
            <!--  <Path Data="M4 6C4 4.89543 4.89543 4 6 4H14.1716C14.702 4 15.2107 4.21071 15.5858 4.58579L19.4142 8.41421C19.7893 8.78929 20 9.29799 20 9.82843V18C20 19.1046 19.1046 20 18 20H6C4.89543 20 4 19.1046 4 18V6Z"  -->
            <!--  Fill="Black"  -->
            <!--  Opacity=".15"/>  -->
            <!--  <Path Data="M15 20V15H9V20M18 20H6C4.89543 20 4 19.1046 4 18V6C4 4.89543 4.89543 4 6 4H14.1716C14.702 4 15.2107 4.21071 15.5858 4.58579L19.4142 8.41421C19.7893 8.78929 20 9.29799 20 9.82843V18C20 19.1046 19.1046 20 18 20Z"  -->
            <!--  Stroke="Black"  -->
            <!--  StrokeThickness="1.5"  -->
            <!--  StrokeLineCap="Round"  -->
            <!--           StrokeJoin="Round"></Path> -->
            <!--   </Canvas> -->
            <!-- </Viewbox> -->
            <TextBlock Text="Connect to service" />
          </StackPanel>
        </Button>
      </StackPanel>
    </UniformGrid>
  </StackPanel>
</UserControl>
