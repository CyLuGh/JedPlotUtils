<UserControl
    d:DesignHeight="200"
    d:DesignWidth="500"
    mc:Ignorable="d"
    x:Class="JedPlotUtils.LiveCharts.Avalonia.Components.TimeSeriesViewerConnectionView"
    x:DataType="viewModels:TimeSeriesViewerConfigurationViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:JedPlotUtils.ViewModels;assembly=JedPlotUtils"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel VerticalSpacing="16">
        <UniformGrid DockPanel.Dock="Bottom" Rows="1">
            <CheckBox
                Content="Persist settings"
                IsChecked="{Binding PersistSettings}"
                Margin="10,0,0,5" />
            <StackPanel
                HorizontalAlignment="Right"
                Margin="0,0,5,5"
                Orientation="Horizontal"
                Spacing="5"
                VerticalAlignment="Bottom">
                <Button
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True"
                    Theme="{DynamicResource GhostButtonTheme}" />
                <Button
                    Classes="Primary"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding PersistSettings}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <!-- <Viewbox> -->
                        <!--   <Canvas Width="24" Height="24"> -->
                        <!--  <Path Data="M4 6C4 4.89543 4.89543 4 6 4H14.1716C14.702 4 15.2107 4.21071 15.5858 4.58579L19.4142 8.41421C19.7893 8.78929 20 9.29799 20 9.82843V18C20 19.1046 19.1046 20 18 20H6C4.89543 20 4 19.1046 4 18V6Z"  -->
                        <!--  Fill="Black"  -->
                        <!--  Opacity=".15"/>  -->
                        <!--  <Path Data="M15 20V15H9V20M18 20H6C4.89543 20 4 19.1046 4 18V6C4 4.89543 4.89543 4 6 4H14.1716C14.702 4 15.2107 4.21071 15.5858 4.58579L19.4142 8.41421C19.7893 8.78929 20 9.29799 20 9.82843V18C20 19.1046 19.1046 20 18 20Z"  -->
                        <!--  Stroke="Black"  -->
                        <!--  StrokeThickness="1.5"  -->
                        <!--  StrokeLineCap="Round"  -->
                        <!--           StrokeJoin="Round"></Path> -->
                        <!--   </Canvas> -->
                        <!-- </Viewbox> -->
                        <TextBlock Text="Connect to service" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </UniformGrid>

        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Margin="20,0"
                Text="JD+ Connection"
                VerticalAlignment="Center" />

            <Separator />

            <UniformGrid
                Columns="1"
                HorizontalAlignment="Stretch"
                Margin="10"
                RowSpacing="10"
                VerticalAlignment="Top">

                <StackPanel Spacing="4">
                    <TextBlock Text="JD+ server address" />
                    <TextBox HorizontalAlignment="Stretch" Text="{Binding WebServiceAddress}" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>








    </DockPanel>
</UserControl>
