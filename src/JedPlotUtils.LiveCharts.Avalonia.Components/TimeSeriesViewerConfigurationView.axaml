<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:JedPlotUtils.ViewModels;assembly=JedPlotUtils"
             xmlns:palette="clr-namespace:JedPlotUtils.Palette;assembly=JedPlotUtils"
             mc:Ignorable="d" d:DesignHeight="450"
             x:Class="JedPlotUtils.LiveCharts.Avalonia.Components.TimeSeriesViewerConfigurationView"
             x:DataType="viewModels:TimeSeriesViewerConfigurationViewModel">
  <DockPanel Margin="5"
             VerticalSpacing="20">
    <Button Command="{Binding SaveCommand}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Height="30"
            Margin="0 0 5 5"
            DockPanel.Dock="Bottom">
      <StackPanel Orientation="Horizontal"
                  Spacing="5">
        <Viewbox>
          <Canvas Width="24" Height="24">
            <Path Data="M4 6C4 4.89543 4.89543 4 6 4H14.1716C14.702 4 15.2107 4.21071 15.5858 4.58579L19.4142 8.41421C19.7893 8.78929 20 9.29799 20 9.82843V18C20 19.1046 19.1046 20 18 20H6C4.89543 20 4 19.1046 4 18V6Z"
                  Fill="Black"
                  Opacity=".15"/>
            <Path Data="M15 20V15H9V20M18 20H6C4.89543 20 4 19.1046 4 18V6C4 4.89543 4.89543 4 6 4H14.1716C14.702 4 15.2107 4.21071 15.5858 4.58579L19.4142 8.41421C19.7893 8.78929 20 9.29799 20 9.82843V18C20 19.1046 19.1046 20 18 20Z"
                  Stroke="Black"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"></Path>
          </Canvas>
        </Viewbox>
        <TextBlock Text="Save settings"/>
      </StackPanel>
    </Button>

    <TabControl DockPanel.Dock="Top">
      <TabItem Header="Chart">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="5"
              RowSpacing="7">
          <TextBlock Text="Selection mode:"
                     VerticalAlignment="Center"
                     Grid.Row="0"
                     Grid.Column="0"/>
          <ComboBox SelectedItem="{Binding SeriesSelectionMode}"
                    ItemsSource="{Binding AvailableSeriesSelectionMode}"
                    MinWidth="300"
                    Grid.Row="0"
                    Grid.Column="1"/>
          <TextBlock Text="Display mode:"
                     VerticalAlignment="Center"
                     Grid.Row="1"
                     Grid.Column="0"/>
          <ComboBox SelectedItem="{Binding DisplayMode}"
                    ItemsSource="{Binding AvailableDisplayMode}"
                    MinWidth="300"
                    Grid.Row="1"
                    Grid.Column="1"/>
          <TextBlock Text="Palette:"
                     VerticalAlignment="Center"
                     Grid.Row="2"
                     Grid.Column="0"/>
          <ComboBox SelectedItem="{Binding Palette}"
                    ItemsSource="{x:Static palette:Palettes.Available}"
                    MinWidth="300"
                    Grid.Row="2"
                    Grid.Column="1">
              <ComboBox.ItemTemplate>
                  <DataTemplate DataType="palette:IPalette">
                      <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
              </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </TabItem>
      <TabItem Header="JD+">
        <UniformGrid RowSpacing="6"
                     Columns="1"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch">
          <DockPanel HorizontalSpacing="4">
            <TextBlock Text="JDPlus Service:"
                       VerticalAlignment="Center"/>
            <TextBox Text="{Binding Path=WebServiceAddress}"
                     MinWidth="300"/>
          </DockPanel>
        </UniformGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
