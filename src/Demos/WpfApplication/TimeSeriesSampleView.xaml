<rxui:ReactiveUserControl x:Class="WpfApplication.TimeSeriesSampleView"
                          x:TypeArguments="demodata:TimeSeriesSampleViewModel"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"
                          xmlns:demodata="clr-namespace:DemoData;assembly=DemoData"
                          mc:Ignorable="d"
                          d:DesignHeight="450"
                          d:DesignWidth="800">
    <DockPanel>
        <Button x:Name="ButtonSample" 
                Content="Display sample"
                DockPanel.Dock="Bottom" />
        <scottplot:WpfPlot x:Name="SPlot" />
    </DockPanel>
</rxui:ReactiveUserControl>
