<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:JedPlotUtils.ScottPlot.Common.Components.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="JedPlotUtils.Scottplot.Avalonia.Components.Views.CsvParserView"
             x:DataType="viewmodels:CsvParserViewModel">
  <StackPanel Spacing="10"
              MaxWidth="1000">
    <UniformGrid Rows="1"
                 Margin="10">
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="10 5"
                  Spacing="5">
        <TextBlock Text="Separator:"
                   VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Separators}"
                  SelectedItem="{Binding Separator}"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal"
                 Margin="10 5"
                 Spacing="5">
        <TextBlock Text="Decimal separator:"
                   VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding DecimalSeparators}"
                  SelectedItem="{Binding DecimalSeparator}"/>
      </StackPanel>

      <CheckBox Content="Has headers"
                IsChecked="{Binding HasHeaders}"
                HorizontalAlignment="Center"/>

      <StackPanel Orientation="Horizontal"
                 Margin="10 5"
                 Spacing="5">
        <TextBlock Text="Period index:"
                   VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Columns}"
                  SelectedItem="{Binding PeriodIndex}"/>
      </StackPanel>
    </UniformGrid>

    <HeaderedContentControl Header="Preview file content"
                            Margin="20 10">
      <ItemsControl ItemsSource="{Binding DataPreview}"
                    HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"
                        Spacing="5"
                        Margin="5"
                        HorizontalAlignment="Center"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="viewmodels:CsvColumnSelectorViewModel">
            <ToggleButton IsCancel="{Binding IsSelected}"
                          IsEnabled="{Binding IsSelectable}"
                          Content="{Binding Content}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </HeaderedContentControl>

    <Button Content="Import"
            HorizontalAlignment="Right"
            Margin="20 10"/>

  </StackPanel>

</UserControl>
